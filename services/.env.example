# ============================================================
# R U Socrates — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# The API loads .env automatically on startup.

# ----------------------------------------------------------
# Database (SQLite default — change for PostgreSQL in prod)
# ----------------------------------------------------------
# SQLite (default, for dev):
DATABASE_URL=

# PostgreSQL (for production — Phase 3):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rusocrates

# ----------------------------------------------------------
# LiteLLM — LLM Provider Configuration (with Fallback Support)
# ----------------------------------------------------------
# R U Socrates uses LiteLLM to call 100+ models via a single interface.
# Set providers and keys, and optionally configure fallback order.
#
# Supported providers: openai, anthropic, azure, gemini,
#   deepseek, ollama, openrouter, volcengine, dashscope, ...

# --- OpenAI (e.g. gpt-4o-mini, gpt-4o) ---
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Anthropic (e.g. claude-3-5-sonnet) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- DeepSeek ---
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_BASE=https://api.deepseek.com

# --- DashScope / Qwen (阿里百炼) ---
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# --- Ollama (local models) ---
# OLLAMA_API_BASE=http://localhost:11434

# ----------------------------------------------------------
# Default Models (with Fallback Order)
# ----------------------------------------------------------
# Comma-separated list of LiteLLM model strings in fallback order.
# First model is primary, subsequent are fallbacks.
# Examples:
#   "openai/gpt-4o-mini,anthropic/claude-3-5-sonnet-20241022"
#   "dashscope/qwen-plus,deepseek/deepseek-chat,ollama/llama3"
DEFAULT_MODELS=dashscope/qwen-plus

# ----------------------------------------------------------
# Single Default Model (backward compatibility)
# ----------------------------------------------------------
# LiteLLM model string. Examples:
#   openai/gpt-4o-mini
#   anthropic/claude-3-5-sonnet-20241022
#   dashscope/qwen-plus
#   ollama/llama3
DEFAULT_MODEL=dashscope/qwen-plus

# ----------------------------------------------------------
# Embedding Model (sentence-transformers)
# ----------------------------------------------------------
# Change only if you want a different embedding model.
# ~200 MB download on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ----------------------------------------------------------
# Port (default: 8000)
# ----------------------------------------------------------
# API_PORT=8000

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
# LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
